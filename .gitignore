# ===== 敏感信息（绝不入库）=====
# 浏览器持久化配置：包含通过验证后的 TikTok cookie 会话
.browser-profile/
.browser-profile-cdp/
.browser-profile-fresh/
tests/

# ===== 运行产物（体积大、可重新生成）=====
# 探针/抓取原始产物：截图、页面HTML、原始响应JSON
probe/
# 生成的报告（同事各自生成）
report/*.xlsx
# 抓取数据存档（按商品ID，可重新抓）
probe/us_cdp/reviews_*.json

# ===== 运行时状态 =====
.aios/context-db/
.contextdb-enable

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== 其他 =====
# Excel 打开时的锁文件（注意：gitignore 不支持行内注释，需独立一行）
~$*.xlsx
*.tmp
*.log
node_modules/

# ===== 抓取数据存档（可再生）=====
output/

# Clean skill distribution packages and validation records
dist/

# ===== AI 客户端配置（AIOS 安装的本机工具链，不入库）=====
.agents/
.codex/
.gemini/
.grok/
.hermes/
.opencode/
.pi/
.qoder/
.workbuddy/
.zcode/
AGENTS.md
CLAUDE.md
GEMINI.md
opencode.json
scripts/lib/

# .claude/ 只保留本项目 skill（tiktok-review-harvest），其余本机配置忽略
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/tiktok-review-harvest/
